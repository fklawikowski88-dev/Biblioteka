<UserControl x:Class="GameManagerWPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Witaj w GameVault" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Wszystkie gry w jednym miejscu — bez zgubionych list i notatek."
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,22"/>
            <UniformGrid Columns="3" Margin="0,0,0,22">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="ŁĄCZNIE GIER" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding TotalGames}" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="UKOŃCZONE" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding CompletedGames}" FontSize="32" FontWeight="Bold" Foreground="#FF86EFAC" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
                    <StackPanel><TextBlock Text="DO OGRANIA" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock Text="{Binding ToPlayGames}" FontSize="32" FontWeight="Bold" Foreground="#FFFCD34D" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock Text="Szybki start" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="• Dodaj grę i uzupełnij jej platformę, gatunek oraz ocenę." Margin="0,4"/>
                    <TextBlock Text="• Filtruj bibliotekę po tytule, gatunku lub platformie." Margin="0,4"/>
                    <TextBlock Text="• Dane zapisują się automatycznie w pliku JSON." Margin="0,4"/>
                    <TextBlock Text="• Zaznacz grę na liście, aby ją edytować lub usunąć." Margin="0,4"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
