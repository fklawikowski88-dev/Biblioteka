<UserControl x:Class="GameManagerWPF.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Statystyki kolekcji" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Wszystkie gry" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalGames}" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Ukończone" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding CompletedGames}" FontSize="30" FontWeight="Bold" Foreground="#FF86EFAC" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Do ogrania" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding ToPlayGames}" FontSize="30" FontWeight="Bold" Foreground="#FFFCD34D" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Plik danych:" Foreground="{StaticResource MutedBrush}" Margin="0,20,0,5"/>
            <TextBlock Text="{Binding StoragePath}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
