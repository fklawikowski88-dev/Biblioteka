<Window x:Class="GameManagerWPF.Views.GameEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dane gry" Height="650" Width="520" MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dane gry" FontSize="23" FontWeight="Bold" Margin="0,0,0,18"/>
                <TextBlock Text="Tytuł *"/>
                <TextBox x:Name="TitleBox" MaxLength="100"/>
                <TextBlock Text="Gatunek"/>
                <ComboBox x:Name="GenreBox" IsEditable="True">
                    <ComboBoxItem Content="Akcja"/><ComboBoxItem Content="RPG"/><ComboBoxItem Content="Strategia"/>
                    <ComboBoxItem Content="Wyścigi"/><ComboBoxItem Content="Symulator"/><ComboBoxItem Content="Przygodowa"/>
                    <ComboBoxItem Content="Horror"/><ComboBoxItem Content="Indie"/><ComboBoxItem Content="Inne"/>
                </ComboBox>
                <TextBlock Text="Platforma"/>
                <ComboBox x:Name="PlatformBox" IsEditable="True">
                    <ComboBoxItem Content="PC"/><ComboBoxItem Content="PlayStation"/><ComboBoxItem Content="Xbox"/>
                    <ComboBoxItem Content="Nintendo Switch"/><ComboBoxItem Content="Inna"/>
                </ComboBox>
                <TextBlock Text="Rok wydania (1970–2100)"/>
                <TextBox x:Name="YearBox"/>
                <TextBlock Text="Ocena (0–10)"/>
                <TextBox x:Name="RatingBox"/>
                <TextBlock Text="Status"/>
                <ComboBox x:Name="StatusBox">
                    <ComboBoxItem Content="Do ogrania"/><ComboBoxItem Content="W trakcie"/>
                    <ComboBoxItem Content="Ukończona"/><ComboBoxItem Content="Porzucona"/>
                </ComboBox>
                <TextBlock Text="Notatki"/>
                <TextBox x:Name="NotesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFFCA5A5" TextWrapping="Wrap" Margin="0,2,0,10"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Anuluj" Click="Cancel_Click"/>
            <Button Content="Zapisz" Style="{StaticResource AccentButton}" Click="Save_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
