<Window x:Class="GameManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GameManagerWPF.Views"
        Title="GameVault — Menedżer gier" Height="760" Width="1180"
        MinHeight="620" MinWidth="920" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FF151A23" Padding="20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GAMEVAULT" FontSize="22" FontWeight="Bold" Foreground="#FFC4B5FD" Margin="0,8,0,4"/>
                    <TextBlock Text="Twoja kolekcja gier" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,28"/>
                    <Button Content="⌂  Pulpit" Command="{Binding NavigateCommand}" CommandParameter="Home" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="▤  Moje gry" Command="{Binding NavigateCommand}" CommandParameter="Games" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
                    <Button Content="◷  Statystyki" Command="{Binding NavigateCommand}" CommandParameter="Statistics" HorizontalContentAlignment="Left"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Separator Background="#FF343E50" Margin="0,16"/>
                    <TextBlock Text="DANE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#F87171" TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <Button Content="Zapisz teraz" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Twoja biblioteka" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Zarządzaj kolekcją i śledź postępy." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="+ Dodaj grę" Command="{Binding AddGameCommand}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
            <ContentControl Grid.Row="1">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content">
                            <Setter.Value><views:HomeView/></Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Games">
                                <Setter Property="Content"><Setter.Value><views:GameListView/></Setter.Value></Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Statistics">
                                <Setter Property="Content"><Setter.Value><views:StatisticsView/></Setter.Value></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
